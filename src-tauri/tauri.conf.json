{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SONE",
  "version": "0.16.0",
  "identifier": "io.github.lullabyX.sone",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SONE",
        "width": 1200,
        "height": 800,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libgstreamer1.0-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav",
          "gstreamer1.0-alsa",
          "libsecret-1-0",
          "libasound2 | libasound2t64",
          "librsvg2-common"
        ],
        "section": "sound",
        "priority": "optional"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3",
          "gstreamer1",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free",
          "gstreamer1-plugin-libav",
          "alsa-lib",
          "libsecret",
          "librsvg2"
        ],
        "release": "1"
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "gstreamer-hooks.nsi"
      },
      "wix": {
        "fragmentPaths": [
          "gstreamer-fragment.wxs"
        ],
        "componentRefs": [
          "comp_bin_ffi_7.dll",
          "comp_bin_FLAC_8.dll",
          "comp_bin_gio_2.0_0.dll",
          "comp_bin_glib_2.0_0.dll",
          "comp_bin_gmodule_2.0_0.dll",
          "comp_bin_gobject_2.0_0.dll",
          "comp_bin_gstadaptivedemux_1.0_0.dll",
          "comp_bin_gstaudio_1.0_0.dll",
          "comp_bin_gstbase_1.0_0.dll",
          "comp_bin_gstisoff_1.0_0.dll",
          "comp_bin_gstnet_1.0_0.dll",
          "comp_bin_gstpbutils_1.0_0.dll",
          "comp_bin_gstreamer_1.0_0.dll",
          "comp_bin_gstriff_1.0_0.dll",
          "comp_bin_gstrtp_1.0_0.dll",
          "comp_bin_gsttag_1.0_0.dll",
          "comp_bin_gsturidownloader_1.0_0.dll",
          "comp_bin_gstvideo_1.0_0.dll",
          "comp_bin_intl_8.dll",
          "comp_bin_libcrypto_3_x64.dll",
          "comp_bin_libssl_3_x64.dll",
          "comp_bin_nghttp2.dll",
          "comp_bin_ogg_0.dll",
          "comp_bin_orc_0.4_0.dll",
          "comp_bin_pcre2_8_0.dll",
          "comp_bin_psl_5.dll",
          "comp_bin_soup_3.0_0.dll",
          "comp_bin_sqlite3_0.dll",
          "comp_bin_xml2_16.dll",
          "comp_bin_z_1.dll",
          "comp_lib_gst_gstadaptivedemux2.dll",
          "comp_lib_gst_gstasio.dll",
          "comp_lib_gst_gstaudioconvert.dll",
          "comp_lib_gst_gstaudioparsers.dll",
          "comp_lib_gst_gstaudioresample.dll",
          "comp_lib_gst_gstcoreelements.dll",
          "comp_lib_gst_gstdash.dll",
          "comp_lib_gst_gstdecklink.dll",
          "comp_lib_gst_gstflac.dll",
          "comp_lib_gst_gstisomp4.dll",
          "comp_lib_gst_gstplayback.dll",
          "comp_lib_gst_gstsoup.dll",
          "comp_lib_gst_gsttypefindfunctions.dll",
          "comp_lib_gst_gstvolume.dll",
          "comp_lib_gst_gstwasapi2.dll",
          "comp_lib_gst_gstwinks.dll",
          "comp_lib_gio_gioopenssl.dll"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tidal"
        ]
      }
    }
  }
}